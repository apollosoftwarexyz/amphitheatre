{
    "@@locale": "en",
    "cancel": "Cancel",
    "@cancel": {
        "description": "Label for the cancel button. This replaces the close button in the editor."
    },
    "close": "Close",
    "@close": {
        "description": "Label for the close button. Shown in the top-left of the video player and editor."
    },
    "done": "Done",
    "@done": {
        "description": "Label for the done button. Shown in the top-right of the video editor, used to confirm the crop."
    },
    "back10Seconds": "-10s",
    "@back10Seconds": {
        "description": "Label for the button that skips backwards in the video, by 10 seconds."
    },
    "forward10Seconds": "+10s",
    "@forward10Seconds": {
        "description": "Label for the button that skips forwards in the video, by 10 seconds."
    },
    "pause": "Pause",
    "@pause": {
        "description": "Label for the button that pauses the video."
    },
    "play": "Play",
    "@play": {
        "description": "Label for the button that plays the video."
    },
    "replay": "Replay",
    "@replay": {
        "description": "Label for the button that replays the video."
    },
    "preparingToExportVideo": "Preparing to export video...",
    "@preparingToExportVideo": {
        "description": "Label indicating that the video is about to start exporting."
    },
    "exportingVideo": "Exporting video ({progress})...",
    "@exportingVideo": {
        "description": "Label indicating the progress when exporting a video with percentage progress.",
        "placeholders": {
            "progress": {
                "type": "double",
                "format": "decimalPercentPattern",
                "optionalParameters": {
                    "decimalDigits": 1
                }
            }
        }
    },
    "unknownError": "An unknown error occurred.",
    "@unknownError": {
        "description": "An unknown error occurred."
    },
    "retry": "Try again",
    "@retry": {
        "description": "Label for the action, offered with an export failure message, that starts the export again."
    },
    "videoLoadFailed": "This video can't be played.",
    "@videoLoadFailed": {
        "description": "Shown in the player in place of the video when it failed to load."
    },
    "selectedDuration": "{time} selected",
    "@selectedDuration": {
        "description": "Shown under the editor's timeline, indicating the length of the current selection (e.g., '00:42 selected').",
        "placeholders": {
            "time": {
                "type": "String"
            }
        }
    }
}
